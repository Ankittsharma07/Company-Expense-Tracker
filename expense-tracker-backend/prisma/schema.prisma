generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Plan {
  FREE
  PRO
}

enum ExpenseStatus {
  PENDING_MANAGER
  PENDING_ADMIN
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  APPROVED
  REJECTED
}

enum ApprovalLevel {
  MANAGER
  ADMIN
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationAuditStatus {
  SENT
  SKIPPED
  FAILED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  LOCAL_GOOGLE
}

model Company {
  id           String   @id @default(cuid())
  name         String
  plan         Plan     @default(FREE)
  baseCurrency String   @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users     User[]
  expenses  Expense[]
  approvals Approval[]
  passwordResetAuditLogs PasswordResetAuditLog[]
}

model User {
  id                        String       @id @default(cuid())
  companyId                 String
  name                      String
  email                     String       @unique
  role                      Role         @default(EMPLOYEE)
  authProvider              AuthProvider @default(LOCAL)  
  passwordHash              String?
  emailNotificationsEnabled Boolean      @default(true)
  inAppNotificationsEnabled Boolean      @default(true)
  preferredCurrency         String?
  avatarUrl                 String?
  googleAvatarUrl           String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
  expenses     Expense[]
  approvals    Approval[] @relation("ApprovalsByUser")
  notifications Notification[]
  notificationAuditLogs NotificationAuditLog[]
  passwordResetTokens PasswordResetToken[]
  passwordResetAuditActor PasswordResetAuditLog[] @relation("PasswordResetActor")
  passwordResetAuditTarget PasswordResetAuditLog[] @relation("PasswordResetTarget")

  @@index([companyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PasswordResetAuditLog {
  id            String   @id @default(cuid())
  companyId     String
  actorId       String
  targetUserId  String
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  actor   User    @relation("PasswordResetActor", fields: [actorId], references: [id])
  target  User    @relation("PasswordResetTarget", fields: [targetUserId], references: [id])

  @@index([companyId])
  @@index([actorId])
  @@index([targetUserId])
}

model Expense {
  id              String        @id @default(cuid())
  companyId       String
  userId          String
  description     String
  category        String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String
  originalAmount  Decimal       @db.Decimal(12, 2)
  originalCurrency String
  exchangeRate    Decimal       @db.Decimal(18, 8)
  baseAmount      Decimal       @db.Decimal(12, 2)
  baseCurrency    String
  exchangeRateBase String?
  exchangeRates    Json?
  exchangeRateTimestamp DateTime?
  rateProvider    String?
  rateTimestamp   DateTime?
  status          ExpenseStatus @default(PENDING_MANAGER)
  receiptUrl      String?
  receiptPublicId String?
  receiptType     String?
  uploadedAt      DateTime?
  expenseDate     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company     Company       @relation(fields: [companyId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  approvals   Approval[]

  @@index([companyId])
  @@index([userId])
}

model Approval {
  id            String         @id @default(cuid())
  companyId     String
  expenseId     String
  approvedById  String
  status        ApprovalStatus
  level         ApprovalLevel
  comment       String?
  createdAt     DateTime       @default(now())

  company       Company        @relation(fields: [companyId], references: [id])
  expense       Expense        @relation(fields: [expenseId], references: [id])
  approvedBy    User           @relation("ApprovalsByUser", fields: [approvedById], references: [id])

  @@index([companyId])
  @@index([expenseId])
  @@index([approvedById])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
}

model NotificationAuditLog {
  id              String                 @id @default(cuid())
  userId          String
  userRole        Role
  notificationType String
  channel         NotificationChannel
  status          NotificationAuditStatus
  reason          String?
  createdAt       DateTime               @default(now())

  user            User                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([channel])
  @@index([status])
}
