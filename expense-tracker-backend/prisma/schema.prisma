generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Plan {
  FREE
  PRO
}

enum ExpenseStatus {
  PENDING_MANAGER
  PENDING_ADMIN
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  APPROVED
  REJECTED
}

enum ApprovalLevel {
  MANAGER
  ADMIN
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationAuditStatus {
  SENT
  SKIPPED
  FAILED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model Company {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  expenses  Expense[]
  approvals Approval[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String   @unique
  role         Role     @default(EMPLOYEE)
  authProvider AuthProvider @default(LOCAL)  
  passwordHash String?
  emailNotificationsEnabled Boolean @default(true)
  inAppNotificationsEnabled Boolean @default(true)
  avatarUrl    String?
  googleAvatarUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
  expenses     Expense[]
  approvals    Approval[] @relation("ApprovalsByUser")
  notifications Notification[]
  notificationAuditLogs NotificationAuditLog[]

  @@index([companyId])
}

model Expense {
  id              String        @id @default(cuid())
  companyId       String
  userId          String
  description     String
  category        String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  status          ExpenseStatus @default(PENDING_MANAGER)
  receiptUrl      String?
  receiptPublicId String?
  receiptType     String?
  uploadedAt      DateTime?
  expenseDate     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company     Company       @relation(fields: [companyId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  approvals   Approval[]

  @@index([companyId])
  @@index([userId])
}

model Approval {
  id            String         @id @default(cuid())
  companyId     String
  expenseId     String
  approvedById  String
  status        ApprovalStatus
  level         ApprovalLevel
  comment       String?
  createdAt     DateTime       @default(now())

  company       Company        @relation(fields: [companyId], references: [id])
  expense       Expense        @relation(fields: [expenseId], references: [id])
  approvedBy    User           @relation("ApprovalsByUser", fields: [approvedById], references: [id])

  @@index([companyId])
  @@index([expenseId])
  @@index([approvedById])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
}

model NotificationAuditLog {
  id              String                 @id @default(cuid())
  userId          String
  userRole        Role
  notificationType String
  channel         NotificationChannel
  status          NotificationAuditStatus
  reason          String?
  createdAt       DateTime               @default(now())

  user            User                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([channel])
  @@index([status])
}
